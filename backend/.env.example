AWS_PROFILE=learner-lab
AWS_REGION=us-east-1
# Temporary Learner Lab credentials. Never commit the populated .env file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
STORAGE_BACKEND=memory
USERS_TABLE=CsvInsightUsers
DATASETS_TABLE=CsvInsightDatasets
UPLOAD_BUCKET=replace-with-upload-bucket
AVATAR_BUCKET=replace-with-avatar-bucket
JWT_SECRET=replace-with-a-long-random-value
JWT_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=10485760
EXPOSE_RESET_TOKEN=true
FRONTEND_ORIGINS=http://localhost:5500
