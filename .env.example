AWS_PROFILE=learner-lab
AWS_REGION=us-east-1
# Temporary Learner Lab credentials. Never commit the populated .env file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
STORAGE_BACKEND=memory
USERS_TABLE=CsvInsightUsers
DATASETS_TABLE=CsvInsightDatasets
UPLOAD_BUCKET=replace-with-upload-bucket
AVATAR_BUCKET=replace-with-avatar-bucket
ATHENA_DATABASE=csv_insight
ATHENA_OUTPUT_LOCATION=s3://replace-with-upload-bucket/athena-results/
ATHENA_WORKGROUP=primary
ATHENA_QUERY_TIMEOUT_SECONDS=20
# Leave blank for an ephemeral local secret; AWS mode requires a random value of at least 32 characters.
JWT_SECRET=
JWT_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=10485760
# Local demo only. Must be false in AWS mode.
EXPOSE_RESET_TOKEN=true
# Verified SES sender for AWS password recovery.
RESET_EMAIL_SENDER=
FRONTEND_ORIGINS=http://localhost:5500
